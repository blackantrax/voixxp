# Variables d'environnement VoixXP. Les vraies valeurs vivent dans Vercel
# (projet voixxp > Settings > Environment Variables), jamais dans le depot.

# Paiement Mobile Money / carte (Flutterwave API v3)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_V3_WEBHOOK_HASH=
# Optionnel, defaut https://api.flutterwave.com/v3 (FLUTTERWAVE_API_BASE_URL = bac a sable v4, ignore)
FLUTTERWAVE_V3_API_BASE_URL=

# Supabase (projet voixxp). La cle publiable et l'URL ont des valeurs par defaut dans le code.
# Cle secrete (sb_secret_...) : enregistre paiements et liste d'attente. Serveur uniquement.
SUPABASE_SECRET_KEY=

# Serveur de clonage de voix (optionnel ; sinon acces anticipe)
CLONE_API_URL=
CLONE_API_KEY=
